<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Page de lancement Android : fond blanc, aucune icône (D-009). -->
    <style name="Theme.WordGame.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launch_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.WordGame</item>
    </style>

    <style name="Theme.WordGame" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
